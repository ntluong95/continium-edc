  is_ajax tinyint(1)
  is_cron tinyint(1)
  ui_id int(11)
  Indexes {
    (lvr_id) [pk]
    (log_view_id) [unique, name: "log_view_id"]
  }
}

Table redcap_messages {
  message_id int(10)
  thread_id int(10)
  sent_time datetime
  author_user_id int(10)
  message_body text
  attachment_doc_id int(10)
  stored_url varchar(256)
  Indexes {
    (message_id) [pk]
  }
}

Table redcap_messages_recipients {
  recipient_id int(10)
  thread_id int(10)
  recipient_user_id int(10)
  all_users tinyint(1)
  prioritize tinyint(1)
  conv_leader tinyint(1)
  Indexes {
    (recipient_id) [pk]
    (recipient_user_id,thread_id) [unique, name: "recipient_user_thread_id"]
  }
}

Table redcap_messages_status {
  status_id int(10)
  message_id int(10)
  recipient_id int(10)
  recipient_user_id int(10)
  urgent tinyint(1)
  Indexes {
    (status_id) [pk]
  }
}

Table redcap_messages_threads {
  thread_id int(10)
  type enum('CHANNEL','NOTIFICATION','CONVERSATION')
  channel_name varchar(100)
  invisible tinyint(1)
  archived tinyint(1)
  project_id int(11)
  Indexes {
    (thread_id) [pk]
  }
}

Table redcap_metadata {
  project_id int(10)
  field_name varchar(100)
  field_phi varchar(5)
  form_name varchar(100)
  form_menu_description varchar(255)
  field_order float
  field_units varchar(50)
  element_preceding_header mediumtext
  element_type varchar(50)
  element_label mediumtext
  element_enum mediumtext
  element_note mediumtext
  element_validation_type varchar(255)
  element_validation_min varchar(255)
  element_validation_max varchar(255)
  element_validation_checktype varchar(50)
  branching_logic text
  field_req int(1)
  edoc_id int(10)
  edoc_display_img int(1)
  custom_alignment enum('LH','LV','RH','RV')
  stop_actions text
  question_num varchar(50)
  grid_name varchar(100)
  grid_rank int(1)
  misc mediumtext
  video_url varchar(255)
  video_display_inline tinyint(1)
  Indexes {
    (project_id,field_name) [pk]
  }
}

Table redcap_metadata_archive {
  project_id int(10)
  field_name varchar(100)
  field_phi varchar(5)
  form_name varchar(100)
  form_menu_description varchar(255)
  field_order float
  field_units varchar(50)
  element_preceding_header mediumtext
  element_type varchar(50)
  element_label mediumtext
  element_enum mediumtext
  element_note mediumtext
  element_validation_type varchar(255)
  element_validation_min varchar(255)
  element_validation_max varchar(255)
  element_validation_checktype varchar(50)
  branching_logic text
  field_req int(1)
  edoc_id int(10)
  edoc_display_img int(1)
  custom_alignment enum('LH','LV','RH','RV')
  stop_actions text
  question_num varchar(50)
  grid_name varchar(100)
  grid_rank int(1)
  misc mediumtext
  video_url varchar(255)
  video_display_inline tinyint(1)
  pr_id int(10)
  Indexes {
    (project_id,field_name,pr_id) [unique, name: "project_field_prid"]
  }
}

