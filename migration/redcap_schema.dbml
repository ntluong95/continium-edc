Project REDCap {
  database_type: "MySQL"
}

Table redcap_actions {
  action_id int(10)
  project_id int(10)
  survey_id int(10)
  action_trigger enum('MANUAL','ENDOFSURVEY','SURVEYQUESTION')
  action_response enum('NONE','EMAIL_PRIMARY','EMAIL_SECONDARY','EMAIL_TERTIARY','STOPSURVEY','PROMPT')
  custom_text text
  recipient_id int(10)
  Indexes {
    (action_id) [pk]
    (survey_id,recipient_id) [unique, name: "survey_recipient_id"]
  }
}

Table redcap_ai_log {
  ai_id int(11)
  ts datetime
  service varchar(100)
  type varchar(100)
  project_id int(11)
  user_id int(11)
  num_chars_sent int(11)
  num_words_sent int(11)
  num_chars_received int(11)
  num_words_received int(11)
  Indexes {
    (ai_id) [pk]
  }
}

Table redcap_alerts {
  alert_id int(10)
  project_id int(10)
  alert_title varchar(100)
  alert_type enum('EMAIL','SMS','VOICE_CALL','SENDGRID_TEMPLATE')
  alert_stop_type enum('RECORD','RECORD_EVENT','RECORD_EVENT_INSTRUMENT','RECORD_INSTRUMENT','RECORD_EVENT_INSTRUMENT_INSTANCE')
  email_deleted tinyint(1)
  alert_expiration datetime
  form_name varchar(255)
  form_name_event int(10)
  alert_condition text
  ensure_logic_still_true tinyint(1)
  do_not_clear_recurrences tinyint(1)
  prevent_piping_identifiers tinyint(1)
  email_incomplete tinyint(1)
  email_from varchar(191)
  email_from_display varchar(150)
  email_to text
  phone_number_to text
  email_cc text
  email_bcc text
  email_subject varchar(255)
  alert_message text
  email_failed varchar(255)
  email_attachment_variable text
  email_attachment1 int(10)
  email_attachment2 int(10)
  email_attachment3 int(10)
  email_attachment4 int(10)
  email_attachment5 int(10)
  email_repetitive tinyint(1)
  email_repetitive_change tinyint(1)
  email_repetitive_change_calcs tinyint(1)
  cron_send_email_on enum('now','date','time_lag','next_occurrence')
  cron_send_email_on_date datetime
  cron_send_email_on_time_lag_days int(4)
  cron_send_email_on_time_lag_hours int(3)
  cron_send_email_on_time_lag_minutes int(3)
  cron_send_email_on_field varchar(255)
  cron_send_email_on_field_after enum('before','after')
  cron_send_email_on_next_day_type enum('DAY','WEEKDAY','WEEKENDDAY','SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY')
  cron_send_email_on_next_time time
  cron_repeat_for float
  cron_repeat_for_units enum('DAYS','HOURS','MINUTES')
  cron_repeat_for_max smallint(4)
  email_timestamp_sent datetime
  email_sent tinyint(1)
  alert_order int(10)
  sendgrid_template_id text
  sendgrid_template_data text
  sendgrid_mail_send_configuration text
  Indexes {
    (alert_id) [pk]
  }
}

Table redcap_alerts_recurrence {
  aq_id int(10)
  alert_id int(10)
  creation_date datetime
  record varchar(100)
  event_id int(10)
  instrument varchar(100)
  instance smallint(4)
  send_option enum('now','date','time_lag','next_occurrence')
  times_sent smallint(4)
  last_sent datetime
  status enum('IDLE','QUEUED','SENDING')
  first_send_time datetime
  next_send_time datetime
  Indexes {
    (aq_id) [pk]
    (alert_id,record,event_id,instrument,instance) [unique, name: "alert_id_record_instrument_instance"]
  }
}

Table redcap_alerts_sent {
  alert_sent_id int(10)
  alert_id int(10)
  record varchar(100)
  event_id int(10)
  instrument varchar(100)
  instance smallint(4)
  last_sent datetime
  Indexes {
    (alert_sent_id) [pk]
    (alert_id,record,event_id,instrument,instance) [unique, name: "alert_id_record_event_instrument_instance"]
  }
}

Table redcap_alerts_sent_log {
  alert_sent_log_id int(10)
  alert_sent_id int(10)
  alert_type enum('EMAIL','SMS','VOICE_CALL','SENDGRID_TEMPLATE')
  time_sent datetime
  email_from varchar(191)
  email_to text
  phone_number_to text
  email_cc text
  email_bcc text
  subject text
  message mediumtext
  attachment_names text
  Indexes {
    (alert_sent_log_id) [pk]
  }
}

Table redcap_auth {
  username varchar(191)
  password varchar(255)
  password_salt varchar(255)
  legacy_hash int(1)
  temp_pwd int(1)
  password_question int(10)
  password_answer text
  password_question_reminder datetime
  password_reset_key varchar(191)
  Indexes {
    (username) [pk]
    (password_reset_key) [unique, name: "password_reset_key"]
  }
}

Table redcap_auth_history {
  username varchar(255)
  password varchar(255)
  timestamp datetime
}

Table redcap_auth_questions {
  qid int(10)
  question text
  Indexes {
    (qid) [pk]
  }
}

Table redcap_cache {
  cache_id bigint(19)
  project_id int(11)
  cache_key varchar(191)
  data longblob
  ts datetime
  expiration datetime
  invalidation_strategies text
  Indexes {
    (cache_id) [pk]
    (project_id,cache_key) [unique, name: "project_id_cache_key"]
  }
}

Table redcap_cde_cache {
  cache_id int(10)
  tinyId varchar(50)
  publicId varchar(50)
  steward varchar(100)
  question text
  choices text
  updated_on datetime
  Indexes {
    (cache_id) [pk]
    (publicId) [unique, name: "publicId"]
    (tinyId) [unique, name: "tinyId"]
  }
}

Table redcap_cde_field_mapping {
  project_id int(10)
  field_name varchar(100)
  tinyId varchar(50)
  publicId varchar(50)
  questionId varchar(50)
  steward varchar(100)
  web_service varchar(50)
  org_selected varchar(100)
  Indexes {
    (project_id,field_name) [unique, name: "project_field"]
  }
}

Table redcap_config {
  field_name varchar(191)
  value mediumtext
  Indexes {
    (field_name) [pk]
  }
}

Table redcap_crons {
  cron_id int(10)
  cron_name varchar(100)
  external_module_id int(11)
  cron_description text
  cron_enabled enum('ENABLED','DISABLED')
  cron_frequency int(10)
  cron_max_run_time int(10)
  cron_instances_max int(2)
  cron_instances_current int(2)
  cron_last_run_start datetime
  cron_last_run_end datetime
  cron_times_failed int(2)
  cron_external_url text
  Indexes {
    (cron_id) [pk]
    (cron_name,external_module_id) [unique, name: "cron_name_module_id"]
  }
}

Table redcap_crons_datediff {
  dd_id int(10)
  project_id int(10)
  record varchar(100)
  asi_updated_at datetime
  asi_last_update_start datetime
  asi_status enum('QUEUED','PROCESSING')
  alert_updated_at datetime
  alert_last_update_start datetime
  alert_status enum('QUEUED','PROCESSING')
  Indexes {
    (dd_id) [pk]
    (project_id,record) [unique, name: "project_record"]
  }
}

Table redcap_crons_history {
  ch_id int(10)
  cron_id int(10)
  cron_run_start datetime
  cron_run_end datetime
  cron_run_status enum('PROCESSING','COMPLETED','FAILED')
  cron_info text
  Indexes {
    (ch_id) [pk]
  }
}

Table redcap_custom_queries {
  qid int(10)
  title text
  query text
  Indexes {
    (qid) [pk]
  }
}

Table redcap_custom_queries_folders {
  folder_id int(10)
  name varchar(64)
  position smallint(4)
  Indexes {
    (folder_id) [pk]
  }
}

Table redcap_custom_queries_folders_items {
  folder_id int(10)
  qid int(10)
  Indexes {
    (folder_id,qid) [unique, name: "folder_id_qid"]
  }
}

Table redcap_dashboard_ip_location_cache {
  ip varchar(100)
  latitude varchar(50)
  longitude varchar(50)
  city varchar(255)
  region varchar(255)
  country varchar(255)
  Indexes {
    (ip) [pk]
  }
}

Table redcap_data {
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  value text
  instance smallint(4)
}

Table redcap_data2 {
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  value text
  instance smallint(4)
}

Table redcap_data3 {
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  value text
  instance smallint(4)
}

Table redcap_data4 {
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  value text
  instance smallint(4)
}

Table redcap_data5 {
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  value text
  instance smallint(4)
}

Table redcap_data6 {
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  value text
  instance smallint(4)
}

Table redcap_data_access_groups {
  group_id int(10)
  project_id int(10)
  group_name varchar(255)
  Indexes {
    (group_id) [pk]
  }
}

Table redcap_data_access_groups_users {
  project_id int(10)
  group_id int(10)
  username varchar(191)
  Indexes {
    (group_id,username) [unique, name: "group_id"]
    (username,project_id,group_id) [unique, name: "username"]
  }
}

Table redcap_data_dictionaries {
  dd_id int(10)
  project_id int(10)
  doc_id int(10)
  ui_id int(10)
  Indexes {
    (dd_id) [pk]
  }
}

Table redcap_data_import {
  import_id int(10)
  project_id int(10)
  user_id int(10)
  dag_id int(10)
  filename varchar(191)
  upload_time datetime
  completed_time datetime
  total_processing_time int(10)
  status enum('INITIALIZING','QUEUED','PROCESSING','COMPLETED','FAILED','CANCELED','PAUSED')
  csv_header mediumtext
  records_provided int(10)
  records_imported int(10)
  total_errors int(10)
  delimiter enum(',',';','TAB')
  date_format enum('YMD','MDY','DMY')
  overwrite_behavior enum('normal','overwrite')
  force_auto_number tinyint(1)
  change_reason text
  Indexes {
    (import_id) [pk]
  }
}

Table redcap_data_import_rows {
  row_id int(10)
  import_id int(10)
  record_provided varchar(100)
  record varchar(100)
  event_id int(10)
  row_status enum('QUEUED','PROCESSING','COMPLETED','FAILED','CANCELED')
  start_time datetime
  end_time datetime
  total_time int(10)
  row_data longtext
  error_count int(10)
  errors text
  Indexes {
    (row_id) [pk]
    (import_id,row_id) [unique, name: "import_row_id"]
  }
}

Table redcap_data_quality_resolutions {
  res_id int(10)
  status_id int(10)
  ts datetime
  user_id int(10)
  response_requested int(1)
  response enum('DATA_MISSING','TYPOGRAPHICAL_ERROR','CONFIRMED_CORRECT','WRONG_SOURCE','OTHER')
  comment text
  current_query_status enum('OPEN','CLOSED','VERIFIED','DEVERIFIED')
  upload_doc_id int(10)
  field_comment_edited int(1)
  Indexes {
    (res_id) [pk]
  }
}

Table redcap_data_quality_rules {
  rule_id int(10)
  project_id int(10)
  rule_order int(3)
  rule_name text
  rule_logic text
  real_time_execute int(1)
  Indexes {
    (rule_id) [pk]
  }
}

Table redcap_data_quality_status {
  status_id int(10)
  rule_id int(10)
  pd_rule_id int(2)
  non_rule int(1)
  project_id int(11)
  record varchar(100)
  event_id int(10)
  field_name varchar(100)
  repeat_instrument varchar(100)
  instance smallint(4)
  status int(2)
  exclude int(1)
  query_status enum('OPEN','CLOSED','VERIFIED','DEVERIFIED')
  assigned_user_id int(10)
  Indexes {
    (status_id) [pk]
    (non_rule,project_id,record,event_id,field_name,instance) [unique, name: "nonrule_proj_record_event_field"]
    (pd_rule_id,record,event_id,field_name,project_id,instance) [unique, name: "pd_rule_proj_record_event_field"]
    (rule_id,record,event_id,instance) [unique, name: "rule_record_event"]
  }
}

Table redcap_ddp_log_view {
  ml_id int(10)
  time_viewed datetime
  user_id int(10)
  project_id int(10)
  source_id varchar(255)
  Indexes {
    (ml_id) [pk]
  }
}

Table redcap_ddp_log_view_data {
  ml_id int(10)
  source_field varchar(100)
  source_timestamp datetime
  md_id int(10)
}

Table redcap_ddp_mapping {
  map_id int(10)
  external_source_field_name varchar(100)
  is_record_identifier int(1)
  project_id int(10)
  event_id int(10)
  field_name varchar(100)
  temporal_field varchar(100)
  preselect enum('MIN','MAX','FIRST','LAST','NEAR')
  Indexes {
    (map_id) [pk]
    (project_id,event_id,field_name,external_source_field_name) [unique, name: "project_field_event_source"]
    (project_id,is_record_identifier) [unique, name: "project_identifier"]
  }
}

Table redcap_ddp_preview_fields {
  project_id int(10)
  field1 varchar(100)
  field2 varchar(100)
  field3 varchar(100)
  field4 varchar(100)
  field5 varchar(100)
  Indexes {
    (project_id) [pk]
  }
}

Table redcap_ddp_records {
  mr_id int(10)
  project_id int(10)
  record varchar(100)
  updated_at datetime
  item_count int(10)
  fetch_status enum('QUEUED','FETCHING')
  future_date_count int(10)
  Indexes {
    (mr_id) [pk]
    (project_id,record) [unique, name: "project_record"]
  }
}

Table redcap_ddp_records_data {
  md_id int(10)
  map_id int(10)
  mr_id int(10)
  source_timestamp datetime
  source_value text
  source_value2 text
  adjudicated int(1)
  exclude int(1)
  Indexes {
    (md_id) [pk]
  }
}

Table redcap_descriptive_popups {
  popup_id int(10)
  project_id int(10)
  hex_link_color char(7)
  inline_text varchar(100)
  inline_text_popup_description text
  active_on_surveys tinyint(1)
  active_on_data_entry_forms tinyint(1)
  first_occurrence_only tinyint(1)
  list_instruments longtext
  list_survey_pages longtext
  Indexes {
    (popup_id) [pk]
  }
}

Table redcap_docs {
  docs_id int(11)
  project_id int(10)
  docs_date date
  docs_name varchar(255)
  docs_size double
  docs_type text
  docs_file longblob
  docs_comment text
  docs_rights text
  export_file int(1)
  temp int(1)
  Indexes {
    (docs_id) [pk]
  }
}

Table redcap_docs_attachments {
  docs_id int(10)
  Indexes {
    (docs_id) [pk]
  }
}

Table redcap_docs_folders {
  folder_id int(10)
  project_id int(11)
  name varchar(150)
  parent_folder_id int(10)
  dag_id int(11)
  role_id int(10)
  admin_only tinyint(1)
  deleted tinyint(1)
  Indexes {
    (folder_id) [pk]
  }
}

Table redcap_docs_folders_files {
  docs_id int(10)
  folder_id int(10)
  Indexes {
    (docs_id) [pk]
    (docs_id,folder_id) [unique, name: "docs_folder_id"]
  }
}

Table redcap_docs_share {
  docs_id int(10)
  hash varchar(100)
  Indexes {
    (docs_id) [pk]
    (hash) [unique, name: "hash"]
  }
}

Table redcap_docs_to_edocs {
  docs_id int(11)
  doc_id int(11)
  Indexes {
    (docs_id,doc_id) [pk]
  }
}

Table redcap_econsent {
  consent_id int(10)
  project_id int(10)
  survey_id int(10)
  version varchar(64)
  active tinyint(1)
  type_label varchar(64)
  custom_econsent_label text
  notes text
  firstname_field varchar(100)
  firstname_event_id int(11)
  lastname_field varchar(100)
  lastname_event_id int(11)
  dob_field varchar(100)
  dob_event_id int(11)
  allow_edit tinyint(1)
  signature_field1 varchar(100)
  signature_field2 varchar(100)
  signature_field3 varchar(100)
  signature_field4 varchar(100)
  signature_field5 varchar(100)
  consent_form_location_field varchar(100)
  Indexes {
    (consent_id) [pk]
    (survey_id) [unique, name: "survey_id"]
  }
}

Table redcap_econsent_forms {
  consent_form_id int(10)
  consent_id int(10)
  version varchar(64)
  consent_form_active tinyint(1)
  creation_time datetime
  uploader int(10)
  consent_form_pdf_doc_id int(10)
  consent_form_richtext mediumtext
  consent_form_filter_dag_id int(10)
  consent_form_filter_lang_id varchar(50)
  Indexes {
    (consent_form_id) [pk]
    (consent_id,version,consent_form_active,consent_form_filter_dag_id,consent_form_filter_lang_id) [unique, name: "consent_id_version_active_dag_lang"]
  }
}

Table redcap_edocs_data_mapping {
  doc_id int(10)
  project_id int(10)
  event_id int(10)
  record varchar(100)
  field_name varchar(100)
  instance smallint(4)
  Indexes {
    (doc_id) [pk]
  }
}

Table redcap_edocs_metadata {
  doc_id int(10)
  stored_name varchar(255)
  mime_type varchar(255)
  doc_name varchar(255)
  doc_size int(10)
  file_extension varchar(20)
  gzipped int(1)
  project_id int(10)
  stored_date datetime
  delete_date datetime
  date_deleted_server datetime
  Indexes {
    (doc_id) [pk]
  }
}

Table redcap_ehr_access_tokens {
  patient varchar(191)
  mrn varchar(191)
  token_owner int(11)
  expiration datetime
  access_token text
  refresh_token text
  permission_Patient tinyint(1)
  permission_Observation tinyint(1)
  permission_Condition tinyint(1)
  permission_MedicationOrder tinyint(1)
  permission_AllergyIntolerance tinyint(1)
  ehr_id int(11)
  Indexes {
    (token_owner,mrn,ehr_id) [unique, name: "token_owner_mrn_ehr"]
    (token_owner,patient,ehr_id) [unique, name: "token_owner_patient_ehr"]
  }
}

Table redcap_ehr_datamart_revisions {
  id int(11)
  project_id int(11)
  request_id int(11)
  user_id int(11)
  mrns mediumtext
  date_min date
  date_max date
  fields mediumtext
  date_range_categories text
  approved tinyint(1)
  is_deleted tinyint(1)
  created_at timestamp
  executed_at timestamp
  Indexes {
    (id) [pk]
    (request_id) [unique, name: "request_id"]
  }
}

Table redcap_ehr_fhir_logs {
  id int(11)
  user_id int(11)
  fhir_id varchar(191)
  project_id int(11)
  resource_type varchar(191)
  status int(11)
  environment varchar(191)
  created_at datetime
  mrn varchar(191)
  ehr_id int(11)
  Indexes {
    (id) [pk]
  }
}

Table redcap_ehr_import_counts {
  id int(11)
  ts datetime
  type enum('CDP','CDM','CDP-I')
  adjudicated tinyint(1)
  project_id int(11)
  record varchar(100)
  counts_Patient mediumint(7)
  counts_Observation mediumint(7)
  counts_Condition mediumint(7)
  counts_Medication mediumint(7)
  counts_AllergyIntolerance mediumint(7)
  counts_Encounter mediumint(7)
  counts_Immunization mediumint(7)
  counts_AdverseEvent mediumint(7)
  Indexes {
    (id) [pk]
  }
}

Table redcap_ehr_resource_import_details {
  count_id int(11)
  ehr_import_count_id int(11)
  category varchar(50)
  resource varchar(50)
  count mediumint(7)
  Indexes {
    (count_id) [pk]
  }
}

Table redcap_ehr_resource_imports {
  id int(11)
  ts datetime
  type enum('CDP','CDM','CDP-I')
  adjudicated tinyint(1)
  project_id int(11)
  record varchar(100)
  ehr_id int(11)
  Indexes {
    (id) [pk]
  }
}

Table redcap_ehr_settings {
  ehr_id int(11)
  order int(10)
  ehr_name varchar(255)
  client_id varchar(255)
  client_secret varchar(255)
  fhir_base_url varchar(255)
  fhir_token_url varchar(255)
  fhir_authorize_url varchar(255)
  fhir_identity_provider varchar(255)
  patient_identifier_string varchar(255)
  fhir_custom_auth_params varchar(255)
  Indexes {
    (ehr_id) [pk]
  }
}

Table redcap_ehr_token_rules {
  id int(11)
  project_id int(11)
  user_id int(11)
  priority int(11)
  allow tinyint(1)
  created_at datetime
  updated_at datetime
  Indexes {
    (id) [pk]
    (project_id,user_id) [unique, name: "project_id_userid"]
  }
}

Table redcap_ehr_user_map {
  ehr_username varchar(191)
  redcap_userid int(11)
  ehr_id int(11)
  Indexes {
    (ehr_id,ehr_username) [unique, name: "unique_ehr_username"]
    (ehr_id,redcap_userid) [unique, name: "unique_redcap_userid"]
  }
}

Table redcap_ehr_user_projects {
  project_id int(11)
  redcap_userid int(11)
  Indexes {
    (project_id,redcap_userid) [unique, name: "project_id_userid"]
  }
}

Table redcap_email_users_messages {
  id int(11)
  subject text
  body text
  sent_by int(11)
  created_at datetime
  Indexes {
    (id) [pk]
  }
}

Table redcap_email_users_queries {
  id int(11)
  name text
  description text
  query text
  created_at datetime
  Indexes {
    (id) [pk]
  }
}

Table redcap_error_log {
  error_id int(10)
  log_view_id bigint(19)
  time_of_error datetime
  error text
  Indexes {
    (error_id) [pk]
  }
}

Table redcap_esignatures {
  esign_id int(11)
  project_id int(10)
  record varchar(100)
  event_id int(10)
  form_name varchar(100)
  instance smallint(4)
  username varchar(255)
  timestamp datetime
  Indexes {
    (esign_id) [pk]
    (project_id,record,event_id,form_name,instance) [unique, name: "proj_rec_event_form_instance"]
  }
}

Table redcap_events_arms {
  arm_id int(10)
  project_id int(10)
  arm_num int(2)
  arm_name varchar(50)
  Indexes {
    (arm_id) [pk]
    (project_id,arm_num) [unique, name: "proj_arm_num"]
  }
}

Table redcap_events_calendar {
  cal_id int(10)
  record varchar(50)
  project_id int(10)
  event_id int(10)
  baseline_date date
  group_id int(10)
  event_date date
  event_time varchar(5)
  event_status int(2)
  note_type int(2)
  notes text
  extra_notes text
  Indexes {
    (cal_id) [pk]
  }
}

Table redcap_events_calendar_feed {
  feed_id int(10)
  project_id int(10)
  record varchar(100)
  userid int(11)
  hash varchar(100)
  Indexes {
    (feed_id) [pk]
    (hash) [unique, name: "hash"]
    (project_id,record,userid) [unique, name: "project_record_user"]
  }
}

Table redcap_events_forms {
  event_id int(10)
  form_name varchar(100)
  Indexes {
    (event_id,form_name) [unique, name: "event_form"]
  }
}

Table redcap_events_metadata {
  event_id int(10)
  arm_id int(10)
  day_offset float
  offset_min float
  offset_max float
  descrip varchar(64)
  external_id varchar(255)
  custom_event_label text
  Indexes {
    (event_id) [pk]
  }
}

Table redcap_events_repeat {
  event_id int(10)
  form_name varchar(100)
  custom_repeat_form_label text
  Indexes {
    (event_id,form_name) [unique, name: "event_id_form"]
  }
}

Table redcap_external_links {
  ext_id int(10)
  project_id int(10)
  link_order int(5)
  link_url text
  link_label text
  open_new_window int(10)
  link_type enum('LINK','POST_AUTHKEY','REDCAP_PROJECT')
  user_access enum('ALL','DAG','SELECTED')
  append_record_info int(1)
  append_pid int(1)
  link_to_project_id int(10)
  Indexes {
    (ext_id) [pk]
  }
}

Table redcap_external_links_dags {
  ext_id int(11)
  group_id int(10)
  Indexes {
    (ext_id,group_id) [pk]
  }
}

Table redcap_external_links_exclude_projects {
  ext_id int(11)
  project_id int(10)
  Indexes {
    (ext_id,project_id) [pk]
  }
}

Table redcap_external_links_users {
  ext_id int(11)
  username varchar(191)
  Indexes {
    (ext_id,username) [pk]
  }
}

Table redcap_external_module_settings {
  external_module_id int(11)
  project_id int(11)
  key varchar(255)
  type varchar(12)
  value mediumtext
}

Table redcap_external_modules {
  external_module_id int(11)
  directory_prefix varchar(191)
  Indexes {
    (external_module_id) [pk]
    (directory_prefix) [unique, name: "directory_prefix"]
  }
}

Table redcap_external_modules_downloads {
  module_name varchar(191)
  module_id int(11)
  time_downloaded datetime
  time_deleted datetime
  Indexes {
    (module_name) [pk]
    (module_id) [unique, name: "module_id"]
  }
}

Table redcap_external_modules_log {
  log_id bigint(20)
  timestamp datetime
  ui_id int(11)
  ip varchar(100)
  external_module_id int(11)
  project_id int(11)
  record varchar(100)
  message mediumtext
  Indexes {
    (log_id) [pk]
  }
}

Table redcap_external_modules_log_parameters {
  log_id bigint(20)
  name varchar(255)
  value mediumtext
  Indexes {
    (191) [pk]
  }
}

Table redcap_folders {
  folder_id int(10)
  ui_id int(10)
  name varchar(64)
  position int(10)
  foreground varchar(6)
  background varchar(6)
  collapsed tinyint(1)
  Indexes {
    (folder_id) [pk]
    (ui_id,name) [unique, name: "ui_id_name_uniq"]
  }
}

Table redcap_folders_projects {
  ui_id int(10)
  project_id int(10)
  folder_id int(10)
  Indexes {
    (ui_id,project_id,folder_id) [unique, name: "ui_id_project_folder"]
  }
}

Table redcap_form_display_logic_conditions {
  control_id int(10)
  project_id int(10)
  control_condition text
  apply_to_data_entry tinyint(1)
  apply_to_survey tinyint(1)
  apply_to_mycap tinyint(1)
  Indexes {
    (control_id) [pk]
  }
}

Table redcap_form_display_logic_targets {
  control_id int(10)
  form_name varchar(100)
  event_id int(10)
  Indexes {
    (event_id,form_name,control_id) [unique, name: "event_form_control"]
  }
}

Table redcap_forms {
  project_id int(10)
  form_name varchar(100)
  custom_css text
  Indexes {
    (project_id,form_name) [unique, name: "proj_form"]
  }
}

Table redcap_forms_temp {
  project_id int(10)
  form_name varchar(100)
  custom_css text
  Indexes {
    (project_id,form_name) [unique, name: "proj_form"]
  }
}

Table redcap_history_size {
  date date
  size_db float
  size_files float
  Indexes {
    (date) [pk]
  }
}

Table redcap_history_version {
  date date
  redcap_version varchar(10)
  Indexes {
    (date,redcap_version) [pk]
  }
}

Table redcap_instrument_zip {
  iza_id int(10)
  instrument_id varchar(191)
  upload_count smallint(5)
  Indexes {
    (iza_id,instrument_id) [pk]
  }
}

Table redcap_instrument_zip_authors {
  iza_id int(10)
  author_name varchar(191)
  Indexes {
    (iza_id) [pk]
    (author_name) [unique, name: "author_name"]
  }
}

Table redcap_instrument_zip_origins {
  server_name varchar(191)
  upload_count smallint(5)
  Indexes {
    (server_name) [pk]
  }
}

Table redcap_ip_banned {
  ip varchar(100)
  time_of_ban timestamp
  Indexes {
    (ip) [pk]
  }
}

Table redcap_ip_cache {
  ip_hash varchar(32)
  timestamp timestamp
}

Table redcap_library_map {
  project_id int(10)
  form_name varchar(100)
  type int(11)
  library_id int(10)
  upload_timestamp datetime
  acknowledgement text
  acknowledgement_cache datetime
  promis_key varchar(255)
  scoring_type enum('EACH_ITEM','END_ONLY')
  battery tinyint(1)
  promis_battery_key varchar(255)
  Indexes {
    (project_id,form_name,type,library_id) [pk]
  }
}

Table redcap_locking_data {
  ld_id int(11)
  project_id int(10)
  record varchar(100)
  event_id int(10)
  form_name varchar(100)
  instance smallint(4)
  username varchar(191)
  timestamp datetime
