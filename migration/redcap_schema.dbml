  error_id int(10)
  ssq_id int(10)
  alert_sent_log_id int(10)
  error_message text
  Indexes {
    (error_id) [pk]
  }
}

Table redcap_two_factor_response {
  tf_id int(10)
  user_id int(10)
  time_sent datetime
  phone_number varchar(50)
  verified tinyint(1)
  Indexes {
    (tf_id) [pk]
  }
}

Table redcap_user_allowlist {
  username varchar(191)
  Indexes {
    (username) [pk]
  }
}

Table redcap_user_information {
  ui_id int(10)
  username varchar(191)
  user_email varchar(255)
  user_email2 varchar(255)
  user_email3 varchar(255)
  user_phone varchar(50)
  user_phone_sms varchar(50)
  user_firstname varchar(255)
  user_lastname varchar(255)
  user_inst_id varchar(255)
  super_user tinyint(1)
  account_manager tinyint(1)
  access_system_config tinyint(1)
  access_system_upgrade tinyint(1)
  access_external_module_install tinyint(1)
  admin_rights tinyint(1)
  access_admin_dashboards tinyint(1)
  user_creation datetime
  user_firstvisit datetime
  user_firstactivity datetime
  user_lastactivity datetime
  user_lastlogin datetime
  user_suspended_time datetime
  user_expiration datetime
  user_access_dashboard_view datetime
  user_access_dashboard_email_queued enum('QUEUED','SENDING')
  user_sponsor varchar(255)
  user_comments text
  allow_create_db int(1)
  email_verify_code varchar(20)
  email2_verify_code varchar(20)
  email3_verify_code varchar(20)
  datetime_format enum('M-D-Y_24','M-D-Y_12','M/D/Y_24','M/D/Y_12','M.D.Y_24','M.D.Y_12','D-M-Y_24','D-M-Y_12','D/M/Y_24','D/M/Y_12','D.M.Y_24','D.M.Y_12','Y-M-D_24','Y-M-D_12','Y/M/D_24','Y/M/D_12','Y.M.D_24','Y.M.D_12')
  number_format_decimal enum('.',',')
  number_format_thousands_sep enum(',','.','','SPACE','''')
  csv_delimiter enum(',',';','TAB','SPACE','|','^')
  two_factor_auth_secret varchar(32)
  two_factor_auth_enrolled tinyint(1)
  display_on_email_users int(1)
  two_factor_auth_twilio_prompt_phone tinyint(1)
  two_factor_auth_code_expiration int(3)
  api_token varchar(64)
  messaging_email_preference enum('NONE','2_HOURS','4_HOURS','6_HOURS','8_HOURS','12_HOURS','DAILY')
  messaging_email_urgent_all tinyint(1)
  messaging_email_ts datetime
  messaging_email_general_system tinyint(1)
  messaging_email_queue_time datetime
  ui_state mediumtext
  api_token_auto_request tinyint(1)
  fhir_data_mart_create_project tinyint(1)
  Indexes {
    (ui_id) [pk]
    (api_token) [unique, name: "api_token"]
    (email2_verify_code) [unique, name: "email2_verify_code"]
    (email3_verify_code) [unique, name: "email3_verify_code"]
    (email_verify_code) [unique, name: "email_verify_code"]
    (username) [unique, name: "username"]
  }
}

Table redcap_user_rights {
  project_id int(10)
  username varchar(191)
  expiration date
  role_id int(10)
  group_id int(10)
  lock_record int(1)
  lock_record_multiform int(1)
  lock_record_customize int(1)
  data_export_tool tinyint(1)
  data_export_instruments text
  data_import_tool int(1)
  data_comparison_tool int(1)
  data_logging int(1)
  email_logging int(1)
  file_repository int(1)
  double_data int(1)
  user_rights int(1)
  data_access_groups int(1)
  graphical int(1)
  reports int(1)
  design int(1)
  alerts int(1)
  calendar int(1)
  data_entry text
  api_token varchar(32)
  api_export int(1)
  api_import int(1)
  api_modules int(1)
  mobile_app int(1)
  mobile_app_download_data int(1)
  record_create int(1)
  record_rename int(1)
  record_delete int(1)
  dts int(1)
  participants int(1)
  data_quality_design int(1)
  data_quality_execute int(1)
  data_quality_resolution int(1)
  random_setup int(1)
  random_dashboard int(1)
  random_perform int(1)
  realtime_webservice_mapping int(1)
  realtime_webservice_adjudicate int(1)
  external_module_config text
  mycap_participants int(1)
  Indexes {
    (project_id,username) [pk]
    (api_token) [unique, name: "api_token"]
  }
}

Table redcap_user_roles {
  role_id int(10)
  project_id int(10)
  role_name varchar(255)
  unique_role_name varchar(50)
  lock_record int(1)
  lock_record_multiform int(1)
  lock_record_customize int(1)
  data_export_tool tinyint(1)
  data_export_instruments text
  data_import_tool int(1)
  data_comparison_tool int(1)
  data_logging int(1)
  email_logging int(1)
  file_repository int(1)
  double_data int(1)
  user_rights int(1)
  data_access_groups int(1)
  graphical int(1)
  reports int(1)
  design int(1)
  alerts int(1)
  calendar int(1)
  data_entry text
  api_export int(1)
  api_import int(1)
  api_modules int(1)
  mobile_app int(1)
  mobile_app_download_data int(1)
  record_create int(1)
  record_rename int(1)
  record_delete int(1)
  dts int(1)
  participants int(1)
  data_quality_design int(1)
  data_quality_execute int(1)
  data_quality_resolution int(1)
  random_setup int(1)
  random_dashboard int(1)
  random_perform int(1)
  realtime_webservice_mapping int(1)
  realtime_webservice_adjudicate int(1)
  external_module_config text
  mycap_participants int(1)
  Indexes {
    (role_id) [pk]
    (project_id,unique_role_name) [unique, name: "project_id_unique_role_name"]
  }
}

Table redcap_validation_types {
  validation_name varchar(191)
  validation_label varchar(255)
  regex_js text
  regex_php text
  data_type enum('date','datetime','datetime_seconds','email','integer','mrn','number','number_comma_decimal','phone','postal_code','ssn','text','time','char')
  legacy_value varchar(255)
  visible int(1)
  Indexes {
    (validation_name) [unique, name: "validation_name"]
  }
}

Table redcap_web_service_cache {
  cache_id int(10)
  project_id int(10)
  service varchar(50)
  category varchar(150)
  value varchar(100)
  label varchar(255)
  Indexes {
    (cache_id) [pk]
    (project_id,service,category,value) [unique, name: "project_service_cat_value"]
  }
}

