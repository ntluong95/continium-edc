# ==============================================================================
# continium-license-server (private repo) — Environment Variables
# ==============================================================================
#
# Use as the secret-store template for:
#   - Vercel Hobby (recommended primary host)
#   - Render free Web Service (fallback)
#
# Generate any 32-byte hex token with:
#   openssl rand -hex 32
#
# Generate any base64 RSA / EC keypair for asymmetric license signing with:
#   openssl genpkey -algorithm RSA -out priv.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in priv.pem -out pub.pem
#
# This file lives in the PRIVATE repo only. Never commit a filled-in version.
#
# ==============================================================================

########################################################################
# Runtime mode
########################################################################

NODE_ENV=production
LOG_LEVEL=info
PORT=3100

# Boot assertion: both must be UTC.
TZ=UTC
PGTZ=UTC

########################################################################
# Primary database (Supabase Free — separate project from the EDC's DB)
########################################################################

# Supabase runtime URL.
# If deployed on Vercel/serverless, prefer the Supabase pooler URL for runtime
# to avoid exhausting direct Postgres connections. Keep a direct URL only for
# migrations if the private repo adds a DIRECT_LICENSE_DATABASE_URL.
LICENSE_DATABASE_URL=postgresql://postgres.<license-project>:<password>@<host>:5432/postgres

# Future recommended split:
# LICENSE_DATABASE_URL=postgresql://postgres.<license-project>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_LICENSE_DATABASE_URL=postgresql://postgres.<license-project>:<password>@<host>:5432/postgres

########################################################################
# Redis (Upstash free — may share with EDC; keys are namespaced)
########################################################################

# TCP, TLS-encrypted URL.
REDIS_URL=rediss://default:<password>@<host>:upstash.io:6379

# Optional REST API alternative for serverless / edge runtimes.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

########################################################################
# Admin authentication
########################################################################

# Bearer token required by /api/admin/* endpoints. 32+ chars. Rotate often.
# Generate with: openssl rand -hex 32
CONTINIUM_LICENSE_ADMIN_TOKEN=

# Dual-token rotation slot. Set ONLY during the rolling-deploy window of a
# token rotation (see RUNBOOK §5). Leave empty otherwise.
CONTINIUM_LICENSE_ADMIN_TOKEN_PREV=

########################################################################
# Asymmetric license signing (optional — only if you sign responses)
########################################################################

# RSA / EC private key in PEM format, base64-encoded.
# CONTINIUM_LICENSE_SIGNING_PRIVATE_KEY=

# Algorithm (e.g. RS256, ES256). Match the key type above.
# CONTINIUM_LICENSE_SIGNING_ALGORITHM=RS256

########################################################################
# Email (optional — only if license server sends license-issued emails)
########################################################################

# Recommended: same Brevo SMTP relay as the EDC, with a distinct MAIL_FROM
# so transactional license emails are tagged separately.
# MAIL_FROM=licenses@continium-demo.example
# MAIL_FROM_NAME=Continium License Service
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE_ENABLED=0

########################################################################
# Future payment integration (placeholders — wired in Phase 8 only)
########################################################################

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_STORE_ID=

# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=

########################################################################
# Domain placeholders (Phase 8)
########################################################################

# Production public URL of the license server. Empty while on Vercel default.
# LICENSE_SERVER_PUBLIC_URL=https://license.continium.com

# Allowed origins for the admin UI (if you ever ship one).
# ADMIN_ALLOWED_ORIGINS=https://admin.continium.com

########################################################################
# Observability
########################################################################

# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT=staging

# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=continium-license-server

########################################################################
# Webhook secrets (future — paid integrations)
########################################################################

# WEBHOOK_SHARED_SECRET=
