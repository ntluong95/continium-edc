# ==============================================================================
# Continium EDC (public AGPLv3) — Environment Variables
# ==============================================================================
#
# Use as a starting point for production-style free-tier deployments on:
#   - Vercel Hobby (recommended — SMTP works; TOS bars commercial revenue)
#   - Render free Web Service (fallback — blocks SMTP; requires HTTPS email adapter)
#
# Generate any 32-byte hex secret with:
#   openssl rand -hex 32
#
# DO NOT commit this file once filled in. Copy to your deploy platform's secret
# store. Local development: copy to .env.local in continium/ (gitignored).
#
# ==============================================================================

########################################################################
# Runtime mode
########################################################################

NODE_ENV=production
LOG_LEVEL=info
# Set to 1 to suppress Next.js telemetry pings.
NEXT_TELEMETRY_DISABLED=1

########################################################################
# Public URLs
########################################################################

# Public URL of the deployed app (no trailing slash).
# Free demo (Vercel): https://<project>.vercel.app
# Custom domain (later): https://app.continium.com
WEBAPP_URL=https://<project>.vercel.app

# Must equal WEBAPP_URL (or WEBAPP_URL + base path if you customize one).
# Used by next-auth for callback URLs. Mismatch breaks login.
NEXTAUTH_URL=https://<project>.vercel.app

# Optional: serve under a sub-path of a domain. Only effective at build time.
# BASE_PATH=

# Optional: cdn / public asset URL (defaults to WEBAPP_URL).
# PUBLIC_URL=

########################################################################
# Secrets (32+ random hex bytes)
########################################################################

# next-auth signing secret.
NEXTAUTH_SECRET=

# Application-level encryption (Continium fork uses this for some at-rest fields).
ENCRYPTION_KEY=

# Cron / scheduled-task auth secret. Passed in `x-continium-cron-secret` header.
CRON_SECRET=

########################################################################
# Primary PostgreSQL (Supabase free, 500 MB)
########################################################################

# Supabase: Project Settings → Database → Connection string → Transaction
# (pooler, port 6543). Used by the application at runtime.
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase: Project Settings → Database → Connection string → Session
# (direct, port 5432). Used by Prisma Migrate AND by pg-boss (LISTEN/NOTIFY).
DIRECT_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres

# pg-boss queue connection. Use the DIRECT URL — pooler does not pass
# LISTEN/NOTIFY which pg-boss requires.
JOBS_DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres

# Optional: pg-boss schema name (defaults to "pgboss").
# JOBS_PG_BOSS_SCHEMA=pgboss

# Optional: override follow-up worker URL (defaults to ${WEBAPP_URL}/api/jobs/follow-up-response).
# JOBS_FOLLOW_UP_ENDPOINT_URL=

########################################################################
# Redis (Upstash free, 256 MB, 500K cmds/mo)
########################################################################

# TCP, TLS-encrypted URL. Format: rediss://default:<password>@<host>:6379
REDIS_URL=rediss://default:<password>@<host>:upstash.io:6379

# Optional REST API alternative — lower latency from serverless / edge runtimes.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional separate URL for HTTP-style rate-limit backends.
# REDIS_HTTP_URL=

########################################################################
# Object storage (Cloudflare R2 free, 10 GB, zero egress)
########################################################################

# R2 → Manage R2 API tokens → Create API token → "Object Read & Write".
S3_ACCESS_KEY=
S3_SECRET_KEY=

# R2 endpoints — replace <account-id>.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# R2 uses 'auto' as region.
S3_REGION=auto

# Bucket name created in R2.
S3_BUCKET_NAME=continium-edc-uploads

# R2 requires path-style URLs.
S3_FORCE_PATH_STYLE=1

########################################################################
# Transactional email (Brevo SMTP free, 300/day)
########################################################################

# Vercel Hobby allows outbound SMTP on port 587 — no adapter needed.
# Render free blocks SMTP ports 25/465/587 — requires an HTTPS API adapter
# (Brevo API / Resend API) if Render is the app host.

# Sender identity. Brevo free relay accepts any address; deliverability is
# poor without your own DKIM/SPF — emails may land in spam.
MAIL_FROM=noreply@continium-demo.example
MAIL_FROM_NAME=Continium EDC (Demo)

# Brevo SMTP relay credentials. SMTP & API → SMTP settings → master key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 0 = STARTTLS on 587 (use this). 1 = implicit TLS on 465.
SMTP_SECURE_ENABLED=0
SMTP_AUTHENTICATED=1
SMTP_REJECT_UNAUTHORIZED_TLS=1

########################################################################
# Continium licensing
########################################################################

# Edition selector:
#   selfHosted — no license server traffic; all clinical features default-on.
#   free       — disables v1 clinical features; no license server traffic.
#   cloud      — derives features from the license server. Active license →
#                all features on; inactive / unreachable (past grace) → free.
#                Requires CONTINIUM_LICENSE_SERVER_URL + ENTERPRISE_LICENSE_KEY.
CONTINIUM_EDITION=selfHosted

# License server URL. Required only when CONTINIUM_EDITION=cloud.
# Free demo: https://continium-license-server.vercel.app
# Custom domain (later): https://license.continium.com
# Leave empty for selfHosted / free modes.
CONTINIUM_LICENSE_SERVER_URL=

# License key used to authenticate calls to the license server.
# Issued by POST /api/admin/licenses on the license server.
ENTERPRISE_LICENSE_KEY=

# Stable identifier for this EDC instance. Auto-generated and persisted in the
# DB on first boot if blank. Set explicitly for multi-region deployments.
CONTINIUM_INSTANCE_ID=

# Future target: cache TTL for a first-class Continium LicenseCheckResponse.
# Current legacy license client ignores this and uses fixed cache windows:
# 1-minute memory cache, 24-hour successful fetch cache, 4-day previous-result grace.
# CONTINIUM_LICENSE_CACHE_TTL_SECONDS=3600

# Optional public verification key (only if license server signs responses).
# CONTINIUM_LICENSE_PUBLIC_KEY=

# Comma-separated list of feature keys to disable in selfHosted mode.
# Valid keys (v1): clinicalTemplates, clinicalDataAccessGroups,
#                  clinicalAccessRules, clinicalResponseSync,
#                  clinicalExports, clinicalApiAccess
# Compliance-locked (server refuses to boot if disabled):
#                  clinicalEdc, clinicalAuditLog
CONTINIUM_DISABLED_FEATURES=

########################################################################
# Auth toggles
########################################################################

# 0 = registration enabled (default for the public demo).
SIGNUP_DISABLED=0

# 0 = email/password login enabled.
EMAIL_AUTH_DISABLED=0

# 0 = email verification required (recommended on a public URL).
EMAIL_VERIFICATION_DISABLED=0

# 0 = password reset enabled.
PASSWORD_RESET_DISABLED=0

# Optional: reset token lifetime (5–120 min). Default 30.
# PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30

# 0 = invited users can create an account.
INVITE_DISABLED=0

# Session max age in seconds. Default 86400 (24 h).
# SESSION_MAX_AGE=86400

########################################################################
# Rate limiting & anti-abuse
########################################################################

# 0 = rate limiting enabled (REQUIRED on a public URL).
RATE_LIMITING_DISABLED=0

# Optional Cloudflare Turnstile captcha for signup. Recommended on public URL.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional Google reCAPTCHA v3 alternative.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# WARNING: only enable for trusted self-hosted deployments — SSRF risk.
# DANGEROUSLY_ALLOW_WEBHOOK_INTERNAL_URLS=0

########################################################################
# Audit logs (Continium clinical compliance)
########################################################################

AUDIT_LOG_ENABLED=1
AUDIT_LOG_GET_USER_IP=0

########################################################################
# OAuth providers (optional)
########################################################################

# Configure only the providers you have credentials for. Leave blank to disable.

# GITHUB_ID=
# GITHUB_SECRET=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AZUREAD_CLIENT_ID=
# AZUREAD_CLIENT_SECRET=
# AZUREAD_TENANT_ID=

# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_DISPLAY_NAME=
# OIDC_SIGNING_ALGORITHM=

# SAML_DATABASE_URL=

########################################################################
# Continium AI (optional — only if you have credentials)
########################################################################

# AI_PROVIDER=gcp        # one of: aws | gcp | azure
# AI_MODEL=gemini-2.5-flash

# AI_GCP_PROJECT=
# AI_GCP_LOCATION=
# AI_GCP_CREDENTIALS_JSON=

# AI_AWS_REGION=
# AI_AWS_ACCESS_KEY_ID=
# AI_AWS_SECRET_ACCESS_KEY=
# AI_AWS_SESSION_TOKEN=

# AI_AZURE_BASE_URL=
# AI_AZURE_RESOURCE_NAME=
# AI_AZURE_API_KEY=
# AI_AZURE_API_VERSION=v1

########################################################################
# Integrations (optional)
########################################################################

# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=

# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# GOOGLE_SHEETS_REDIRECT_URL=

# AIRTABLE_CLIENT_ID=

# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# UNSPLASH_ACCESS_KEY=

# CHATWOOT_BASE_URL=
# CHATWOOT_WEBSITE_TOKEN=

########################################################################
# Payments (placeholders — wired in Phase 8)
########################################################################

# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

########################################################################
# Observability
########################################################################

# Sentry — free tier supports 5K errors/month.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT=staging

# OpenTelemetry OTLP exporter (only if a backend like Axiom is wired).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=continium-edc
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=staging
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Prometheus metrics (only if you scrape).
# PROMETHEUS_ENABLED=0
# PROMETHEUS_EXPORTER_PORT=

########################################################################
# Telemetry / analytics
########################################################################

# 1 = disable usage telemetry sent to Continium / Formbricks.
TELEMETRY_DISABLED=1

# Optional Brevo marketing-list sync for new users.
# BREVO_API_KEY=
# BREVO_LIST_ID=

########################################################################
# Misc
########################################################################

# Public-facing legal links (footer on signup / public pages).
PRIVACY_URL=
TERMS_URL=
IMPRINT_URL=
IMPRINT_ADDRESS=

# Minimum role required to manage users from UI (owner | manager | disabled).
# USER_MANAGEMENT_MINIMUM_ROLE=manager

# Account deletion re-auth controls — keep defaults unless you accept the risks.
# DISABLE_ACCOUNT_DELETION_SSO_REAUTH=0
# GOOGLE_ACCOUNT_DELETION_REAUTH_ENABLED=0

# Build-time environment label (production | staging).
ENVIRONMENT=staging

# Translation helper — needed only if you run `pnpm i18n:generate`.
# LINGO_API_KEY=
