{
  "name": "@continium/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo node_modules dist",
    "dev": "dotenv -e ../../.env -- tsx src/main.ts",
    "go": "dotenv -e ../../.env -- tsx src/main.ts",
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint . --ext .ts,.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@continium/audit": "workspace:*",
    "@continium/database": "workspace:*",
    "@continium/jobs": "workspace:*",
    "@continium/logger": "workspace:*",
    "dotenv-cli": "10.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@continium/config-typescript": "workspace:*",
    "@continium/eslint-config": "workspace:*",
    "tsx": "4.21.0",
    "vite": "7.3.3",
    "vitest": "4.1.6"
  }
}
