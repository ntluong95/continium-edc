{
  "name": "@continium/jobs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "homepage": "https://continium.com",
  "license": "MIT",
  "description": "Postgres-backed background jobs for Continium",
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/continium/continium"
  },
  "keywords": [
    "Continium",
    "jobs",
    "queue",
    "pg-boss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules coverage dist",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "lint:report": "eslint . --format json --output-file ../../lint-results/jobs.json",
    "build": "rimraf dist && vite build && tsc --project tsconfig.build.json",
    "test": "vitest run"
  },
  "author": "Continium <hola@continium.com>",
  "dependencies": {
    "@continium/logger": "workspace:*",
    "pg-boss": "11.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@continium/config-typescript": "workspace:*",
    "@continium/eslint-config": "workspace:*",
    "vite": "7.3.3",
    "vitest": "4.1.6"
  }
}
